schema_version: "{{MANIFEST_SCHEMA}}"

project:
  id: "{{PROJECT_ID}}"
  name: "{{PROJECT_NAME}}"
  template: research
  status: active
  repository_root: "."

ownership:
  human:
    - QUESTIONS.md
  agent:
    - CURRENT_HANDOFF.md
    - explore/*/README.md
    - explore/*/report.md
    - explore/*/scripts
    - explore/*/derived
    - explore/*/figures
    - pipeline/pipeline.yaml
    - pipeline/report.md
    - pipeline/src
    - pipeline/config
    - pipeline/tests
  cli:
    - project_manifest.yaml
    - explore/*/task.yaml
    - explore/*/report.html
    - explore/*/report.build.yaml
    - explore/*/runs
    - archive
    - reports/*.html
    - reports/*.build.yaml
    - pipeline/release.yaml
    - work/audit/lifecycle.jsonl

paths:
  instructions: AGENTS.md
  questions: QUESTIONS.md
  handoff: CURRENT_HANDOFF.md
  handoff_archive: docs/handoffs/archive
  explore: explore
  archive: archive
  pipeline: pipeline
  reports: reports
  lifecycle_log: work/audit/lifecycle.jsonl

environment:
  manager: pixi
  policy: root_workspace
  manifest: pixi.toml
  lock: pixi.lock
  nested_workspaces: forbidden

lifecycle:
  model: explore_archive_pipeline
  single_active_explore: true
  human_review_required: true
  report_format: html
  report_language: zh-CN
  input_hash: sha256
