# Boss Hunting optional API credentials (example only; keep real values out of Git).
#
# First use creates skills/boss-hunting/credentials.env in the source repo.
# Fill that one ignored file; all projects use it. Do not put keys in projects.
# BOSS_HUNTING_CREDENTIALS_FILE can explicitly override the shared location.
#
# Every key is an optional accelerator. Missing keys fall back to anonymous
# official APIs, Browser Use on official public pages, or alternative sources.

OPENALEX_API_KEY=

NCBI_API_KEY=

ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

CINII_APP_ID=

SEMANTIC_SCHOLAR_API_KEY=

WOS_API_KEY=
